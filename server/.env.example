# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=
DB_NAME=sweety_db

# Or use DATABASE_URL if preferred:
DATABASE_URL=postgresql://postgres@localhost:5433/sweety_db

# JWT Authentication
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d
